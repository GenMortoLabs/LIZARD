// ai: Stream files packed on the GPU (gpu_zstd.h), stage 3: each block's literals as zstd's four Huffman streams
// ai: (RFC 8878 3.1.1.3.1: the block's residuals split in four, the first three (n + 3) / 4 each), a workgroup a block,
// ai: by the code the host built from the block's counts (tab[(q nb + b) 256 + v]: the code's bits | its length << 16).
// ai: A stream's bits run from its last symbol to its first (the decoder reads it backwards), each code at its bit,
// ai: least significant first: a thread a run of each stream's symbols, its place the bits of the runs after it (a
// ai: suffix sum), its whole words stored, the two it may share with its neighbours OR-ed in; then the end mark, a 1
// ai: past the last code. The four streams back to back from the block's place (mode[blk].y, bytes, a multiple of 4:
// ai: the host's bound of the block's bytes from its counts, so the output holds the bytes that go and no more), each
// ai: its bytes (size); mode[blk].x: 0 Huffman, 1 raw (the block's residuals copied to its place as they are), 2 none
// ai: (one value throughout: the host writes an RLE block).
#version 450
layout(local_size_x = 256) in;
layout(set = 0, binding = 0) readonly buffer Res { uint w[]; } res;
layout(set = 0, binding = 1) readonly buffer Tab { uint e[]; } tab;
layout(set = 0, binding = 2) readonly buffer Mode { uvec2 m[]; } mode;
layout(set = 0, binding = 3) coherent buffer Out { uint w[]; } outw;
layout(set = 0, binding = 4) writeonly buffer Size { uint s[]; } size;
// ai: a: squares, n, wps, nb
layout(set = 0, binding = 5) uniform P { uvec4 a; } p;
shared uint lens[4][256];
shared uint offs[4][256];
shared uint tot[4];
shared uint base[4];
const uint BLOCK = 131072u;
uint sym(uint rb, uint i) { return (res.w[rb + (i >> 2u)] >> (8u * (i & 3u))) & 0xffu; }
void main() {
  const uint b = gl_WorkGroupID.x, q = gl_WorkGroupID.y, t = gl_LocalInvocationID.x;
  const uint blk = q * p.a.w + b;
  const uvec2 md = mode.m[blk];
  const uint start = b * BLOCK, bn = min(p.a.y - start, BLOCK), rbase = q * p.a.z;
  if (md.x == 2u) { if (t < 4u) size.s[blk * 4u + t] = 0u; return; }
  if (md.x == 1u) {
    const uint bw = (bn + 3u) >> 2u, o = md.y >> 2u, r = rbase + (start >> 2u);
    for (uint i = t; i < bw; i += 256u) outw.w[o + i] = res.w[r + i];
    if (t < 4u) size.s[blk * 4u + t] = t == 0u ? bn : 0u;
    return;
  }
  const uint seg = (bn + 3u) / 4u, tb = blk * 256u;
  for (uint s = 0u; s < 4u; s++) {
    const uint s0 = start + s * seg, len = s < 3u ? seg : bn - 3u * seg;
    const uint per = (len + 255u) / 256u, i0 = min(len, t * per), i1 = min(len, i0 + per);
    uint sum = 0u;
    for (uint i = i0; i < i1; i++) sum += tab.e[tb + sym(rbase, s0 + i)] >> 16u;
    lens[s][t] = sum;
  }
  barrier();
  if (t < 4u) {
    uint acc = 0u;
    for (int u = 255; u >= 0; u--) { offs[t][u] = acc; acc += lens[t][u]; }
    tot[t] = acc;
  }
  barrier();
  if (t == 0u) {
    uint at = md.y;
    for (uint s = 0u; s < 4u; s++) {
      base[s] = at * 8u;
      const uint bytes = (tot[s] >> 3u) + 1u;
      size.s[blk * 4u + s] = bytes;
      at += bytes;
    }
  }
  barrier();
  for (uint s = 0u; s < 4u; s++) {
    const uint s0 = start + s * seg, len = s < 3u ? seg : bn - 3u * seg;
    const uint per = (len + 255u) / 256u, i0 = min(len, t * per), i1 = min(len, i0 + per);
    // ai: this thread's symbols from its last to its first, from its place up
    uint pos = base[s] + offs[s][t], word = pos >> 5u, acc = 0u;
    const uint firstWord = word;
    for (uint i = i1; i > i0;) {
      i--;
      const uint e = tab.e[tb + sym(rbase, s0 + i)], l = e >> 16u, code = e & 0xffffu, sh = pos & 31u;
      acc |= code << sh;
      if (sh + l >= 32u) {
        if (word == firstWord) atomicOr(outw.w[word], acc); else outw.w[word] = acc;
        word++;
        acc = sh + l > 32u ? code >> (32u - sh) : 0u;
      }
      pos += l;
    }
    if ((pos & 31u) != 0u) atomicOr(outw.w[word], acc);
  }
  if (t < 4u) {
    const uint T = base[t] + tot[t];
    atomicOr(outw.w[T >> 5u], 1u << (T & 31u));
  }
}
