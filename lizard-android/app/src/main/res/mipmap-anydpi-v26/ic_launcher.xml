<?xml version="1.0" encoding="utf-8"?>
<!-- ai: The launcher icon (2026-10-01; the platform's default until then): white under the mark; the monochrome
     layer (2026-11-16) the mark's frame and its scales' ridges, which a themed launcher tints. minSdk 29, so no bitmap
     fallbacks. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@android:color/white" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
